#!/usr/bin/env bash
# ironclad — the command. Three verbs, no menus.
#
#   ironclad check     score this repo's schema against the rules (read-only)
#   ironclad init      write .agent/ + scripts/ so agent and CI share the rules
#   ironclad doctor    why is this not doing what I expected? (read-only)
#   ironclad rules     list every rule and its effective severity;
#                      `rules explain DB-01` for what it refuses to decide
#   ironclad presets   the built-in presets and their error/warn counts
#   ironclad preset N  switch strictness: balanced | strict | legacy-friendly
#   ironclad status    where the skill and the project policy live
#   ironclad drill     prove your agent knows: selftest the gate, or grade its output
#                      (ironclad drill --selftest | --prompt | answer.sql)
#   ironclad attach    put the standing instruction into AGENTS.md / CLAUDE.md /
#                      GEMINI.md / .cursor/rules so the agent asks before coding
#   ironclad update    is there a newer version? ask once, in plain words
#                      (--check read-only, --notes what changed, --mute stop asking)
#
# `check` and `init` work without a repo config: they fall back to the preset
# shipped in the skill, so the first run needs no setup.

set -euo pipefail

IRONCLAD_HOME="${IRONCLAD_HOME:-$HOME/.agents/skills/ironclad}"
CHECKER="$IRONCLAD_HOME/scripts/check_schema.py"
DRILL="$IRONCLAD_HOME/scripts/drill.py"
UPDATE="$IRONCLAD_HOME/scripts/update_check.py"
AGENT_FILES="$IRONCLAD_HOME/scripts/agent_files.py"
TEMPLATE="$IRONCLAD_HOME/templates/standards.md"
PRESETS="$IRONCLAD_HOME/assets/presets"

die() { echo "ironclad: $*" >&2; exit 1; }

[ -f "$CHECKER" ] || die "skill not found at $IRONCLAD_HOME (re-run the installer)"
command -v python3 >/dev/null 2>&1 || die "python3 is required to run the checker"

find_root() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -d "$d/.git" ] && { echo "$d"; return; }
    d="$(dirname "$d")"
  done
  echo "$PWD"
}

# current preset: repo config wins, skill default otherwise
current_preset() {
  local root; root="$(find_root)"
  if [ -f "$root/.agent/standards.yml" ]; then
    sed -n 's/^name:[[:space:]]*//p' "$root/.agent/standards.yml" | head -1
  else
    echo "balanced"
  fi
}

cmd_check() {
  local root; root="$(find_root)"
  cd "$root"
  # Do NOT append --preset here. The repo's .agent/standards.yml is layered in
  # the checker, and a caller who typed `--preset strict` must keep that choice.
  # This used to append the repo preset *after* the user's args, so argparse
  # took the last one and `ironclad check --preset strict` silently ran as
  # balanced — a gate that passes what it was asked to block.
  local rc=0
  python3 "$CHECKER" "${@:-.}" || rc=$?
  # A one-line nudge on stderr, from cache only — no network here, and the exit code
  # is passed through untouched. A version check must never decide whether a build
  # passed: that would make CI depend on GitHub being reachable.
  # No stderr redirect here: the script prints its hint on stderr, and redirecting
  # it to /dev/null is exactly how the hint silently disappeared the first time.
  # The script owns its own quietness (no tty, muted, or no cached update = silence).
  [ -f "$UPDATE" ] && python3 "$UPDATE" --hint >/dev/null 2>&1 || true
  return $rc
}

# Pass a subcommand straight to the checker and keep its exit code. It must run
# from the repo root like `check` does, or a relative path in a finding points
# somewhere the user did not expect.
cmd_check_sub() {
  local root; root="$(find_root)"
  cd "$root"
  local rc=0
  python3 "$CHECKER" "$@" || rc=$?
  return $rc
}

# Ask only when a human is actually there. `curl | bash` and CI have no tty, and a
# prompt there would hang the pipeline — so the default applies silently instead.
ask_preset() {
  # An explicit choice wins over everything, including CI. This used to be checked
  # after the tty test, so IRONCLAD_PRESET=strict was silently ignored in a pipeline.
  if [ -n "${IRONCLAD_PRESET:-}" ]; then echo "$IRONCLAD_PRESET"; return; fi
  [ -t 0 ] || { echo "balanced"; return; }
  echo >&2
  echo "How strict should this repo be?" >&2
  echo "  1) balanced  (default) — enum and text status block, the rest warn" >&2
  echo "  2) strict    — everything blocks; use for new or clean repos" >&2
  echo "  3) legacy-friendly — everything warns; use for an old repo with debt" >&2
  echo "  4) coherence — no style punished; only mixing enum and integer fails" >&2
  printf "Choose 1-4 [1]: " >&2
  local ans; read -r ans || ans=""
  case "$ans" in
    2) echo "strict" ;;
    3) echo "legacy-friendly" ;;
    4) echo "coherence" ;;
    *) echo "balanced" ;;
  esac
}

cmd_init() {
  local root; root="$(find_root)"
  local dry_run=0
  local preset=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=1 ;;
      -*) die "unknown flag: $arg (try --dry-run)" ;;
      *) preset="$arg" ;;
    esac
  done
  if [ -z "$preset" ]; then
    # Detect first, ask second. A repo that already has artisan or next.config.ts
    # has answered the question the prompt would ask; making someone choose a
    # strictness level for a framework they just installed is a quiz, not a setup.
    local detected why
    detected="$(python3 -c "
import sys
sys.path.insert(0, '$IRONCLAD_HOME')
from ironclad_core.config import suggested_preset
p, why = suggested_preset('$root')
print(p + '|' + why)
" 2>/dev/null || echo '|')"
    preset="${detected%%|*}"
    why="${detected#*|}"
    if [ -n "$preset" ]; then
      echo "detected: ${why:-no markers} → preset $preset"
      echo "          (override with: ironclad init <preset>)"
    fi
  fi
  if [ -z "$preset" ]; then
    preset="$(ask_preset)"
  fi
  case "$preset" in
    1) preset="balanced" ;; 2) preset="strict" ;; 3) preset="legacy-friendly" ;; 4) preset="coherence" ;;
  esac
  [ -f "$PRESETS/$preset.yml" ] || die "unknown preset: $preset (balanced|strict|legacy-friendly)"

  # Nothing here may run twice and produce a different tree. `init` is run by the
  # second teammate, by CI, and by the person who forgot they already ran it; every
  # one of those must leave the repo byte-identical.
  emit() {      # emit <path> <action> [command...]
    local p="$1" act="$2"; shift 2
    if [ "$dry_run" = 1 ]; then
      echo "would $act $p"
      return 0
    fi
    "$@"
  }

  if [ "$dry_run" = 1 ]; then
    echo "dry run — nothing will be written"
  fi

  if [ "$dry_run" = 0 ]; then
    mkdir -p "$root/.agent" "$root/scripts/presets"
  fi
  if [ -f "$root/.agent/standards.yml" ]; then
    echo "kept    .agent/standards.yml (preset: $(current_preset))"
  elif [ "$dry_run" = 1 ]; then
    echo "would write .agent/standards.yml (preset: $preset)"
  else
    cp "$PRESETS/$preset.yml" "$root/.agent/standards.yml"
    echo "wrote   .agent/standards.yml (preset: $preset)"
  fi
  if [ "$dry_run" = 1 ] && [ ! -f "$root/.agent/standards.md" ]; then
    echo "would write .agent/standards.md"
  elif [ -f "$root/.agent/standards.md" ]; then
    # Never clobber a file a human has filled in. But an untouched copy of an older
    # template is not a decision — it is an empty form, and keeping it means the
    # teammate who runs init today still commits "We store status as: (one of)".
    if grep -qE "Fill in|^\(one of\)|\(one of\)|Decided on: <!--" "$root/.agent/standards.md" 2>/dev/null; then
      cp "$TEMPLATE" "$root/.agent/standards.md"
      echo "updated .agent/standards.md (replaced an unfilled template)"
    else
      echo "kept    .agent/standards.md"
    fi
  else
    cp "$TEMPLATE" "$root/.agent/standards.md"
    echo "wrote   .agent/standards.md"
  fi
  # The checker is now an entry point over ironclad_core/. Copying only
  # check_schema.py would produce a repo whose `python3 scripts/check_schema.py`
  # exits 3 ("engine is missing"), so the package travels with it. This is the
  # same rule as the install payload: the thing that runs and the thing that is
  # shipped are listed once.
  sync_payload() {
    # Compare before copying. `cp` always rewrites mtimes, and an `init` that
    # touches 12 files on every run makes `git status` dirty for no reason — which
    # is how people learn to ignore its output.
    local changed=0
    if ! cmp -s "$CHECKER" "$root/scripts/check_schema.py" 2>/dev/null; then
      cp "$CHECKER" "$root/scripts/check_schema.py"; changed=1
      echo "wrote   scripts/check_schema.py"
    fi
    for f in "$PRESETS/"*.yml; do
      local name; name="$(basename "$f")"
      if ! cmp -s "$f" "$root/scripts/presets/$name" 2>/dev/null; then
        cp "$f" "$root/scripts/presets/$name"; changed=1
        echo "wrote   scripts/presets/$name"
      fi
    done
    # The engine is a directory. A version marker tells us whether the copy is
    # current without diffing every byte: content hash of every .py, sorted.
    local want have
    want="$( cd "$IRONCLAD_HOME/ironclad_core" && find . -name '*.py' -type f | sort | xargs sha256sum 2>/dev/null | sha256sum | cut -c1-16 )"
    have=""
    [ -f "$root/scripts/ironclad_core/.ironclad-hash" ] && have="$(cat "$root/scripts/ironclad_core/.ironclad-hash")"
    if [ "$want" != "$have" ]; then
      rm -rf "$root/scripts/ironclad_core"
      cp -R "$IRONCLAD_HOME/ironclad_core" "$root/scripts/ironclad_core"
      find "$root/scripts/ironclad_core" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
      printf '%s' "$want" > "$root/scripts/ironclad_core/.ironclad-hash"
      changed=1
      echo "wrote   scripts/ironclad_core/ ($(find "$root/scripts/ironclad_core" -name '*.py' | wc -l) modules)"
    fi
    [ "$changed" = 1 ] || echo "kept    scripts/ (already current)"
    chmod +x "$root/scripts/check_schema.py" 2>/dev/null || true
  }
  if [ "$dry_run" = 1 ]; then
    echo "would sync scripts/check_schema.py + scripts/presets/ + scripts/ironclad_core/"
  else
    sync_payload
  fi

  if [ -f "$AGENT_FILES" ] && [ -z "${IRONCLAD_NO_AGENT_FILES:-}" ]; then
    echo
    if [ "$dry_run" = 1 ]; then
      echo "would attach the standing instruction to AGENTS.md / CLAUDE.md / GEMINI.md / .cursor/rules"
    else
      python3 "$AGENT_FILES" --project "$root"
    fi
  fi

  if [ "$dry_run" = 1 ]; then
    echo
    echo "dry run: nothing was written. Re-run without --dry-run to apply."
    return 0
  fi

  echo
  echo "Commit these, or the next teammate gets a different rulebook:"
  echo "  git add .agent scripts AGENTS.md && git commit -m 'chore: adopt ironclad standards'"
  echo
  echo "Then, in CI, gate only the files a PR touches — see"
  echo "https://wilsench.my.id/ironclad-next/ci/"
}

cmd_preset() {
  local root; root="$(find_root)"
  local want="${1:-}"
  if [ -z "$want" ]; then
    echo "current: $(current_preset)"
    echo
    echo "change it:"
    for p in balanced strict legacy-friendly coherence; do
      echo "  ironclad preset $p"
    done
    return 0
  fi
  [ -f "$PRESETS/$want.yml" ] || die "unknown preset: $want (balanced|strict|legacy-friendly|coherence)"
  [ -f "$root/.agent/standards.yml" ] || die "no .agent/standards.yml here — run 'ironclad init' first"
  cp "$PRESETS/$want.yml" "$root/.agent/standards.yml"
  echo "preset → $want  (.agent/standards.yml)"
  echo "commit it: git add .agent && git commit -m 'chore: preset $want'"
}

cmd_status() {
  local root; root="$(find_root)"
  echo "skill    : $IRONCLAD_HOME"
  echo "repo     : $root"
  if [ -f "$root/.agent/standards.yml" ]; then
    echo "policy   : present (preset: $(current_preset))"
  else
    echo "policy   : absent — run 'ironclad init'"
  fi
  [ -f "$root/scripts/check_schema.py" ] && echo "checker  : present" || echo "checker  : absent"
}

case "${1:-}" in
  check)   shift; cmd_check "$@" ;;
  # Subcommands the checker owns. They live in Python because they read the same
  # config layering `check` does — a bash re-implementation would drift, and a
  # `rules list` that disagrees with the run is worse than no list at all.
  rules)   shift; cmd_check_sub rules "$@" ;;
  doctor)  cmd_check_sub doctor "$@" ;;
  presets) cmd_check_sub presets ;;
  init)    shift; cmd_init "$@" ;;
  preset)  shift; cmd_preset "$@" ;;
  status)  cmd_status ;;
  version|--version|-V)
    printf "ironclad %s\n" "$(sed -n 's/^version: *//p' "$IRONCLAD_HOME/SKILL.md" 2>/dev/null | head -1)"
    printf "skill: %s\n" "$IRONCLAD_HOME"
    # Report the block that is actually installed, not the default one. A `house`
    # machine used to read 1011 while 1208 chars sat in its CLAUDE.md.
    printf "mode: %s\n" "$(python3 - "$AGENT_FILES" <<'PY' 2>/dev/null
import sys, importlib.util
spec = importlib.util.spec_from_file_location("af", sys.argv[1])
m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
print(m.detect_installed_mode() or "ask (default)")
PY
)"
        printf "block: %s chars\n" "$(python3 - "$AGENT_FILES" <<'PY' 2>/dev/null
import sys, importlib.util
spec = importlib.util.spec_from_file_location("af", sys.argv[1])
m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
print(len((m.detect_installed_body() or m.ASK_BODY).strip()))
PY
)"
    ;;
  drill)   shift; python3 "$DRILL" "$@" ;;
  update|upgrade)
    shift
    [ -f "$UPDATE" ] || die "update check is missing at $UPDATE (re-run the installer)"
    python3 "$UPDATE" "$@" ;;
  attach)
    shift
    # `ironclad attach --global` repairs a machine where the block never got written
    if [ "${1:-}" = "--global" ]; then
      python3 "$AGENT_FILES" --global "${@:2}"
    else
      python3 "$AGENT_FILES" --project "${1:-.}" "${@:2}"
    fi ;;
  ""|-h|--help|help)
    # Print the header comment block, however long it has grown. A fixed line
    # range silently truncated the help the first time a verb was added.
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0" ;;
  *)
    die "unknown command: $1 (try: check | doctor | rules | presets | init | preset | status | drill | attach | update)" ;;
esac
